window = {
	name = "kns_imperial_guard_attire_window"
	size = { 1100 940 }
	parentanchor = center
	position = { 0 0 }
	movable = yes
	layer = top
	allow_outside = yes
	visible = "[GetPlayer.MakeScope.Var('kns_ig_attire_window_open').IsSet]"

	using = Window_Background_Subwindow

		vbox = {
			margin = { 10 10 }
			spacing = 8
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					text = "kns_ig_attire_window_title"
					fontsize = 22
				}

				button_close = {
					onclick = "[GetScriptedGui('kns_close_imperial_guard_attire_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					shortcut = "close_window"
					visible = "[GetPlayer.MakeScope.Var('kns_ig_attire_window_open').IsSet]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 10

				vbox = {
					size = { 420 -1 }
					layoutpolicy_vertical = expanding
					spacing = 8
					datacontext = "[GetPlayer.MakeScope.Var('kns_ig_attire_target').Char]"
					visible = "[GetScriptedGui('kns_gui_ig_has_attire_target').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

					text_single = {
						layoutpolicy_horizontal = expanding
						align = center
						visible = "[Character.IsValid]"
						text = "[Character.GetShortUINameNoTooltip]"
						default_format = "#high"
						fontsize = 18
					}

					widget = {
						size = { 378 560 }
						parentanchor = hcenter
						allow_outside = yes

						portrait_button = {
							parentanchor = center
							size = { 420 560 }
							using = portrait_base
							effectname = "NoHighlight"
							visible = "[GetScriptedGui('kns_gui_ig_attire_is_axe').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'kns_camera_ig_axe', 'throne_room_one_handed_passive_2', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_body.dds"
						}

						portrait_button = {
							parentanchor = center
							size = { 420 560 }
							using = portrait_base
							effectname = "NoHighlight"
							visible = "[GetScriptedGui('kns_gui_ig_attire_is_hammer').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'kns_camera_ig_hammer', 'aggressive_hammer', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_body.dds"
						}

						portrait_button = {
							parentanchor = center
							size = { 420 560 }
							using = portrait_base
							effectname = "NoHighlight"
							visible = "[GetScriptedGui('kns_gui_ig_attire_is_sword').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'kns_camera_ig_sword', 'chudan_no_kamae', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_body.dds"
						}

						portrait_button = {
							parentanchor = center
							size = { 420 560 }
							using = portrait_base
							effectname = "NoHighlight"
							visible = "[GetScriptedGui('kns_gui_ig_attire_is_spear').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'kns_camera_ig_spear', 'relaxed_spear', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_body.dds"
						}

						portrait_button = {
							parentanchor = center
							size = { 420 560 }
							using = portrait_base
							effectname = "NoHighlight"
							visible = "[GetScriptedGui('kns_gui_ig_attire_is_mace').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'kns_camera_ig_mace', 'menacing', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							mask = "gfx/portraits/portrait_mask_body.dds"
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 6

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "kns_ig_window_armor_header"
						default_format = "#high"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "kns_ig_window_armor_hint"
						visible = "[Not( GetScriptedGui('kns_gui_ig_has_attire_target').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
							button_standard = {
								layoutpolicy_horizontal = expanding
								text = "kns_ig_armor_default"
								down = "[GetScriptedGui('kns_gui_ig_armor_default_selected').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('kns_gui_ig_set_armor_default').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								onclick = "[GetScriptedGui('kns_gui_ig_set_armor_default').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "kns_ig_armor_group_holy_roman"
								default_format = "#high"
							}
							button_standard = {
								layoutpolicy_horizontal = expanding
								text = "kns_ig_armor_dde_hre_war_low_nobles"
								visible = "[GetScriptedGui('kns_gui_ig_set_armor_dde_hre_war_low_nobles').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								down = "[GetScriptedGui('kns_gui_ig_armor_dde_hre_war_low_nobles_selected').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('kns_gui_ig_set_armor_dde_hre_war_low_nobles').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								onclick = "[GetScriptedGui('kns_gui_ig_set_armor_dde_hre_war_low_nobles').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							}
							button_standard = {
								layoutpolicy_horizontal = expanding
								text = "kns_ig_armor_dde_hre_war_high_nobles"
								visible = "[GetScriptedGui('kns_gui_ig_set_armor_dde_hre_war_high_nobles').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								down = "[GetScriptedGui('kns_gui_ig_armor_dde_hre_war_high_nobles_selected').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								enabled = "[GetScriptedGui('kns_gui_ig_set_armor_dde_hre_war_high_nobles').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
