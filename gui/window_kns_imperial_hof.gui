window = {
	name = "kns_imperial_hof_window"
	size = { 820 960 }
	parentanchor = center
	position = { 0 0 }
	movable = yes
	layer = top
	allow_outside = yes
	visible = "[GetPlayer.MakeScope.Var('kns_hof_window_open').IsSet]"

	using = Window_Background_Subwindow

		vbox = {
			margin = { 10 10 }
			spacing = 8
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					text = "kns_hof_window_title"
					fontsize = 22
				}

				button_close = {
					onclick = "[GetScriptedGui('kns_close_hof_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					shortcut = "close_window"
					visible = "[GetPlayer.MakeScope.Var('kns_hof_window_open').IsSet]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				background = {
					using = Background_Area_Dark
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					text = "kns_hof_window_subtitle"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8

				button_standard = {
					layoutpolicy_horizontal = expanding
					text = "kns_hof_window_refresh"
					tooltip = "kns_hof_window_refresh_tt"
					onclick = "[GetScriptedGui('kns_gui_refresh_hof_window').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "kns_hof_window_section_champions"
				default_format = "#high"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "kns_hof_window_section_champions_desc"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { -1 280 }

				blockoverride "scrollbox_content" {
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						hbox = {
							visible = "[Or( GetPlayer.MakeScope.Var('kns_hof_champion_1').IsSet, GetPlayer.MakeScope.Var('kns_hof_champion_1_titles').IsSet )]"
							layoutpolicy_horizontal = expanding
							spacing = 8
							datacontext = "[GetPlayer.MakeScope.Var('kns_hof_champion_1').Char]"
							background = {
								using = Background_Area_Dark
							}

							text_single = {
								size = { 44 40 }
								align = center
								parentanchor = vcenter
								text = "1"
								default_format = "#high"
							}

							widget = {
								size = { 85 90 }
								parentanchor = vcenter
								visible = "[GetPlayer.MakeScope.Var('kns_hof_champion_1').IsSet]"
								portrait_head_small = {}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								parentanchor = vcenter
								spacing = 2

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "[Character.GetNameNoTooltip]"
									default_format = "#high"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_champion_1').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_fallen_name"
									default_format = "#high"
									visible = "[Not( GetPlayer.MakeScope.Var('kns_hof_champion_1').IsSet )]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_deceased"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_champion_1_dead').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_row_titles_1"
									default_format = "#positive"
								}
							}
						}
						hbox = {
							visible = "[Or( GetPlayer.MakeScope.Var('kns_hof_champion_2').IsSet, GetPlayer.MakeScope.Var('kns_hof_champion_2_titles').IsSet )]"
