									default_format = "#high"
								}
							}
						}

					}
				}

				blockoverride "scrollbox_empty" {
					visible = "[GetScriptedGui('kns_hof_duelists_empty').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
					text = "kns_hof_window_empty_duelists"
				}
			}
		}
}