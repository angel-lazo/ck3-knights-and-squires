									text = "kns_hof_window_deceased"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_18_dead').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_row_duel_wins_18"
									default_format = "#high"
								}
							}
						}

						hbox = {
							visible = "[Or( GetPlayer.MakeScope.Var('kns_hof_duelist_19').IsSet, GetPlayer.MakeScope.Var('kns_hof_duelist_19_wins').IsSet )]"
							layoutpolicy_horizontal = expanding
							spacing = 8
							datacontext = "[GetPlayer.MakeScope.Var('kns_hof_duelist_19').Char]"
							background = {
								using = Background_Area_Dark
							}

							text_single = {
								size = { 36 40 }
								align = center
								parentanchor = vcenter
								text = "19"
								default_format = "#high"
							}

							widget = {
								size = { 85 90 }
								parentanchor = vcenter
								visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_19').IsSet]"
								portrait_head_small = {}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								parentanchor = vcenter
								spacing = 2

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "[Character.GetNameNoTooltip]"
									default_format = "#high"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_19').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_fallen_name"
									default_format = "#high"
									visible = "[Not( GetPlayer.MakeScope.Var('kns_hof_duelist_19').IsSet )]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_deceased"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_19_dead').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_row_duel_wins_19"
									default_format = "#high"
								}
							}
						}

						hbox = {
							visible = "[Or( GetPlayer.MakeScope.Var('kns_hof_duelist_20').IsSet, GetPlayer.MakeScope.Var('kns_hof_duelist_20_wins').IsSet )]"
							layoutpolicy_horizontal = expanding
							spacing = 8
							datacontext = "[GetPlayer.MakeScope.Var('kns_hof_duelist_20').Char]"
							background = {
								using = Background_Area_Dark
							}

							text_single = {
								size = { 36 40 }
								align = center
								parentanchor = vcenter
								text = "20"
								default_format = "#high"
							}

							widget = {
								size = { 85 90 }
								parentanchor = vcenter
								visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_20').IsSet]"
								portrait_head_small = {}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								parentanchor = vcenter
								spacing = 2

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "[Character.GetNameNoTooltip]"
									default_format = "#high"
									visible = "[GetPlayer.MakeScope.Var('kns_hof_duelist_20').IsSet]"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "kns_hof_window_fallen_name"
									default_format = "#high"
									visible = "[Not( GetPlayer.MakeScope.Var('kns_hof_duelist_20').IsSet )]"
